{
  "manifest_version": 3,
  "name": "EasySS Image Upload",
  "background": {
    "service_worker": "background.js"
  },
  "version": "1.0.0",
  "description": "Intercepta subidas de archivos para permitirte elegir directamente imágenes de tu portapapeles y capturas de pantalla.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "EasySS Image Upload",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["clipboardRead", "clipboardWrite", "storage", "downloads", "contextMenus", "offscreen", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "open-easyss": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Abrir EasySS Selector"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["main_world.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://cobalt.tools/*"],
      "js": ["cobalt_bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://cobalt.tools/*"],
      "js": ["cobalt_bridge_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["modal.html", "modal.css", "modal.js", "offscreen.html", "offscreen.js", "popup.html", "popup.js", "popup.css", "cobalt_bridge.js", "cobalt_bridge_main.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
